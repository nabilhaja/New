# "sandbox" uses BiP's shared sandbox credentials and mocked responses (no
# real quota used, no secrets needed). "production" hits your real account
# and requires BIP_CLIENT_ID / BIP_CLIENT_SECRET below.
BIP_ENV=sandbox

# From the "Open API" page in the BiP Platform (Primary/Admin user only).
# The secret is shown once at generation time. Only used when BIP_ENV=production.
BIP_CLIENT_ID=
BIP_CLIENT_SECRET=

# Space-separated OAuth scopes to request. Must be a subset of what your
# access token was permitted on the Open API management page.
BIP_SCOPE="OPENAPI_NOTICES OPENAPI_AWARDS OPENAPI_SPEND"

# "stdio" (default) is for local MCP clients (Claude Desktop, etc.) that
# launch this as a subprocess. "http" runs it as a standalone hosted server
# with a real URL, for remote MCP clients.
MCP_TRANSPORT=stdio

# Only used when MCP_TRANSPORT=http. Required — protects your BiP credentials
# and daily quota, since the /mcp endpoint would otherwise be open to anyone
# who finds the URL. Generate a random value, e.g. `openssl rand -hex 32`.
MCP_AUTH_TOKEN=8148293785c1c8c69088b2484b38c9add81e258386405241c8f3c552c727b630

# Only used when MCP_TRANSPORT=http. Most hosting platforms set this for you.
PORT=3000
